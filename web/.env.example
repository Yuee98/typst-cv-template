NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server Admin identity, checked against the initialized database.
# local | preview | production; must agree with VERCEL_ENV when hosted.
ADMIN_ENVIRONMENT=

# UI visibility only. Static exports require false or unset.
NEXT_PUBLIC_AI_POLISH_ENABLED=
NEXT_PUBLIC_AI_POLISH_MOCK=

# Server deployment gate (default off); DB control is checked per admission.
AI_POLISH_ENABLED=
SUPABASE_SERVICE_ROLE_KEY=

# Provider secrets only. Profiles in the DB select exact bindings in this
# namespace; code checks the Provider prefix, protocol and official destination.
AI_PROVIDER_KEY_DEEPSEEK_PRIMARY=
AI_PROVIDER_KEY_MIMO_PRIMARY=
AI_PROVIDER_KEY_GEMINI_PRIMARY=
# Google AI Studio key. The owner separately verifies active Cloud Billing and
# data-sharing settings; credential presence does not establish Paid-tier data use.

# Stable HMAC secret for pseudonymous users and request fingerprints.
# Keep stable for the complete request/idempotency retention window.
AI_USER_ID_HMAC_SECRET=

# Deterministic local/CI smoke only; both flags must be enabled together.
# Never enable in a hosted deployment. No Provider secrets are required.
POLISH_FAKE_LLM=
POLISH_FAKE_BACKEND=
