NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- AI polish (server build only — never set these for the static Pages export) ---

# Controls visibility of the AI polish UI entry points. NOT a security switch.
# Must NOT be "true" for a static export: scripts/run-next-mode.mjs refuses
# the build when STATIC_EXPORT=true and this is "true" (a static bundle has no
# API routes, so an AI entry point would be dead weight — Invariant 9).
NEXT_PUBLIC_AI_POLISH_ENABLED=

# Server-only (no NEXT_PUBLIC_ prefix — never expose to the client).
# API key for the DeepSeek polish provider (real provider lands in unit 2.1).
DEEPSEEK_API_KEY=

# Server-only. Supabase service role key used by the polish API for
# terms/quota/log writes (bypasses RLS by design; lands with unit 2.3).
SUPABASE_SERVICE_ROLE_KEY=

# Local/CI only: "true" selects the deterministic fake polish provider
# instead of a real LLM. getPolishProvider() throws when it is combined with
# NODE_ENV=production (see src/server/polish/provider.ts); the guard takes
# effect once the CP2 handler resolves the provider at module scope — the
# Phase 0 stub never calls it.
POLISH_FAKE_LLM=

# --- Used from CP2 (real provider/handler) — not read by the Phase 0 stub ---

# Server-only. Deployment-level hard switch for the AI polish API (default
# off). Read once at module scope; a Vercel env change only takes effect on
# the next deploy, so it is NOT an incident-response kill switch.
AI_POLISH_ENABLED=

# Server-only. Global daily cap on provider-billed requests across all users
# (cost/abuse protection, independent of per-user quota; never refunded).
AI_POLISH_GLOBAL_DAILY_LIMIT=

# Server-only. DeepSeek model id (e.g. deepseek-v4-flash).
AI_POLISH_MODEL=

# Server-only. HMAC secret deriving the pseudonymous provider user id:
# user_id = HMAC_SHA256(AI_USER_ID_HMAC_SECRET, supabaseUserId). The raw
# Supabase UUID/email is never sent to the provider.
AI_USER_ID_HMAC_SECRET=
