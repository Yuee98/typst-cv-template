NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Admin identity. Requires owner bootstrap in the matching DB.
# local | preview | production; Vercel's VERCEL_ENV must also agree.
# No Admin data or entry is included in static exports.
ADMIN_ENVIRONMENT=

# --- AI polish (server build only — never set these for the static Pages export) ---

# Runtime authority is database-backed: the active provider profile/version,
# price version, routing policy, legal bundle, and versioned runtime contract ID are
# selected and frozen by approved DB records. Environment variables provide
# server credentials only; never add AI_PROVIDER, AI_MODEL, or AI_BASE_URL as
# routing switches because they would bypass that versioned/audited authority.
# The reviewed code registry constrains every accepted alias and legal/runtime
# reference; DB rows cannot supply arbitrary URLs or environment variable names.

# Controls visibility of the AI polish UI entry points. NOT a security switch.
# Must NOT be "true" for a static export: scripts/run-next-mode.mjs refuses
# the build when STATIC_EXPORT=true and this is "true" (a static bundle has no
# API routes, so an AI entry point would be dead weight — Invariant 9).
NEXT_PUBLIC_AI_POLISH_ENABLED=

# Client-side development mock for the polish API: "true" makes the dialog
# use the in-memory fake client (deterministic output, quota, dedup) instead
# of POST /api/polish — for developing the UI without a backend. Ignored in
# production builds; only meaningful together with NEXT_PUBLIC_AI_POLISH_ENABLED.
NEXT_PUBLIC_AI_POLISH_MOCK=

# Server-only credential aliases (no NEXT_PUBLIC_ prefix — never expose to
# the client, database, or logs). A DB-approved profile may select only a
# code-registered alias; an unset key keeps that profile fail closed.
# Current official aliases: DeepSeek and MiMo.
DEEPSEEK_API_KEY=
MIMO_API_KEY=

# Future optional alias only. OpenRouter is not enabled by the initial route;
# leave unset until a separately reviewed profile, upstream, legal disclosure,
# and activation are in place.
OPENROUTER_API_KEY=

# Server-only. Supabase service role key used by the polish API for
# terms/quota/ledger writes (bypasses RLS by design; wired since unit 2.3).
SUPABASE_SERVICE_ROLE_KEY=

# Local/CI deterministic smoke only. The public V2 handler accepts this flag
# only together with POLISH_FAKE_BACKEND=true; using fake inference with real
# Supabase accounting is rejected. A production-mode process additionally
# requires CI=true. Never set this in a hosted deployment.
POLISH_FAKE_LLM=

# Local/CI deterministic smoke: "true" replaces auth/terms/quota with
# in-memory fakes so `next start` serves the full polish lifecycle WITHOUT a
# Supabase instance. Requires POLISH_FAKE_LLM=true. Leave both flags unset for
# the real Supabase/backend composition.
POLISH_FAKE_BACKEND=

# --- Server runtime (read by the polish routes since unit 2.3) ---

# Server-only. Deployment-level hard switch for the AI polish API (default
# off). Read once at module scope; a Vercel env change only takes effect on
# the next deploy, so it is NOT an incident-response kill switch.
AI_POLISH_ENABLED=

# NOTE — two cost-control settings are deliberately NOT environment
# variables (do not add them here; setting them is a no-op):
# - The global daily cap on provider-billed requests lives in the database:
#   public.ai_feature_config.global_daily_limit, applied at runtime by the
#   reserve/mark RPCs without a redeploy.
# - AI_PROVIDER, AI_MODEL, and AI_BASE_URL are deliberately not application
#   routing variables. Provider/profile/model/endpoint selection is an exact
#   DB snapshot constrained by the reviewed code registry, so a route change
#   goes through validation, audit, legal review, and activation.

# Server-only. HMAC secret deriving the pseudonymous provider user id:
# user_id = HMAC_SHA256(AI_USER_ID_HMAC_SECRET, supabaseUserId). The raw
# Supabase UUID/email is never sent to the provider.
AI_USER_ID_HMAC_SECRET=
