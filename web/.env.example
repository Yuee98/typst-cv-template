NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- AI polish (server build only — never set these for the static Pages export) ---

# Controls visibility of the AI polish UI entry points. NOT a security switch.
# Must NOT be "true" for a static export: scripts/run-next-mode.mjs refuses
# the build when STATIC_EXPORT=true and this is "true" (a static bundle has no
# API routes, so an AI entry point would be dead weight — Invariant 9).
NEXT_PUBLIC_AI_POLISH_ENABLED=

# Server-only (no NEXT_PUBLIC_ prefix — never expose to the client).
# API key for the DeepSeek polish provider (real provider lands in unit 2.1).
DEEPSEEK_API_KEY=

# Server-only. Supabase service role key used by the polish API for
# terms/quota/log writes (bypasses RLS by design; lands with unit 2.3).
SUPABASE_SERVICE_ROLE_KEY=

# Local/CI only: "true" selects the deterministic fake polish provider
# instead of a real LLM. Startup is refused when combined with
# NODE_ENV=production (see src/server/polish/provider.ts).
POLISH_FAKE_LLM=
